{
  "name": "aws-ec2-manager",
  "version": "1.0.0",
  "description": "Node.js project to create and manipulate AWS EC2 Linux instances and manage file structures on them.",
  "main": "src/index.js",
  "scripts": {
    "start": "node dist/socket-server.js 0",
    "agent-system": "ts-node src/agent-system.ts",
    "agent-system-tempai": "ts-node src/run-tempai-agent.ts",
    "interactive-chat-with-abort": "ts-node src/interactive-chat_tempAI.ts",
    "test-wsl": "node src/run-wsl-tests.js",
    "worker-demo": "tsc src/worker-demo.worker.ts --outDir dist/src && ts-node src/worker-demo.main.ts",
    "build": "tsc && node scripts/copy-js.js",
    "dev": "tsc --watch",
    "socket-server": "ts-node src/socket-server.ts 0",
    "socket-server:dev": "ts-node src/socket-server.ts 0",
    "socket-server:prod": "ts-node src/socket-server.ts 1",
    "socket-server:debug": "node --inspect -r ts-node/register src/socket-server.ts",
    "socket-server:debug:dev": "node --inspect -r ts-node/register src/socket-server.ts 0",
    "socket-server:debug:prod": "node --inspect -r ts-node/register src/socket-server.ts 1",
    "syntax-tree": "ts-node src/syntax-tree-manager.ts",
    "syntax-tree-manager-debug": "node --inspect -r ts-node/register src/syntax-tree-manager.ts",
    "chunk_folder:debug": "node --inspect -r ts-node/register src/chunk_folder.ts",
    "orchestrator": "ts-node src/orchestrator.ts",
    "indexer:debug": "node --inspect -r ts-node/register src/Services/indexer.ts \"F:\\AI_CODER_SUITE\\AI_CODER_REMOTE\"",
    "interactive-chat:debug": "node --inspect -r ts-node/register src/Services/interactive-chat.ts  1 /mnt/efs/AI_CODER",
    "interactive-chat": "ts-node src/Services/interactive-chat.ts",
    "indexer": "ts-node src/indexer.ts ",
    "ssh-client-combined:debug": "node --inspect -r ts-node/register src/Services/ssh-client-combined.ts",
    "test-wsl-background:debug": "node --inspect -r ts-node/register src/test-wsl-background.ts",
    "launcher-custom": "node --inspect -r ts-node/register src/launcher.ts",
    "EditTool:debug": "node --inspect -r ts-node/register src/EditTool.ts",
    "tool-server": "ts-node src/tool-server.ts",
    "tool-server:debug": "node --inspect -r ts-node/register src/tool-server_tempAI.ts",
    "tool-dev-plugin": "ts-node src/Services/tool-dev-plugin.ts",
    "MCP_server:debug": "node --inspect -r ts-node/register src/MCP_Client.ts",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\"",
    "SetupWorkspace:debug": "node --inspect -r ts-node/register src/Services/SetupWorkspace.ts",
    "GithubAuthFlow:debug": "node --inspect -r ts-node/register src/Services/GithubAuthFlow.ts",
    "db-examples": "ts-node src/Services/Database/examples/usage-examples.ts",
    "db-examples:debug": "node --inspect -r ts-node/register src/Services/Database/examples/usage-examples.ts",
    "db-test": "ts-node src/Services/Database/test-database.ts",
    "db-test:debug": "node --inspect -r ts-node/register src/Services/Database/test-database.ts",
    "GithubOAuthFlow:debug": "node --inspect -r ts-node/register src/Services/GithubOAuthFlow.ts",
    "Ec2ServiceExample:debug": "node --inspect -r ts-node/register src/Services/EC2Service.example.ts",
    "Ec2Manager:debug": "node --inspect -r ts-node/register src/Services/EC2Manager.ts",
    "mint-api-key": "ts-node src/scripts/mintApiKey_tempAI.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.59.0",
    "@aws-sdk/client-bedrock": "^3.816.0",
    "@aws-sdk/client-bedrock-runtime": "^3.948.0",
    "@aws-sdk/client-dynamodb": "^3.896.0",
    "@aws-sdk/client-ec2": "^3.913.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/client-secrets-manager": "^3.896.0",
    "@aws-sdk/client-ses": "^3.906.0",
    "@aws-sdk/lib-dynamodb": "^3.896.0",
    "@datastructures-js/priority-queue": "^6.3.5",
    "@modelcontextprotocol/sdk": "^1.17.2",
    "@octokit/app": "^15.1.0",
    "@octokit/rest": "^20.1.2",
    "@paypal/paypal-server-sdk": "^2.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/http-proxy": "^1.17.17",
    "@types/mongodb": "^4.0.6",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.6.7",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "chalk": "^4.1.2",
    "child-process": "^1.0.2",
    "chromadb": "^2.4.6",
    "contextlib": "^0.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "heap-js": "^2.7.1",
    "http-proxy": "^1.18.1",
    "js-tiktoken": "^1.0.21",
    "json-stringify-safe": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "keypress": "^0.2.1",
    "mongodb": "^6.20.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "p-limit": "^3.1.0",
    "parse-diff": "^0.11.1",
    "playwright": "^1.54.2",
    "puppeteer": "^24.15.0",
    "razorpay": "^2.9.8",
    "smee-client": "^2.0.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ssh2": "^1.16.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "uuid": "^8.3.2",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-fetch": "^2.6.13",
    "@types/socket.io": "^3.0.1",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}