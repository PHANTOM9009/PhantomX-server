

AWS_SECRET_ACCESS_KEY_AI=your aws access key for AI Models
AWS_ACCESS_KEY_ID_AI=your aws access key ID for AI models
GITHUB_PAT=you personal github access token for listing repositories and branches
DISABLE_PAYWALL = true


# Add these to your .env file for OAuth 2.0:
GITHUB_OAUTH_CLIENT_ID=your_oauth_app_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_app_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/callback

JWT_SECRET= jwt secret for signing the tokens
MONGODB_CONNECTION_STRING_DEV= mongodb connection string for dev

# OpenRouter platform credentials and optional attribution headers
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_HTTP_REFERER=https://your-application.example
OPENROUTER_APP_TITLE=PhantomX

# variables for naming the collections of mongodb
USER_CREDENTIAL_DB =UserCredentials
USER_CREDENTIAL_COLLECTION=Credentials
USER_REFRESH_TOKEN_COLLECTION=refreshTokens
ORGANIZATION_DB=Organizations
ORGANIZATION_COLLECTION=Organizations

SECRET_ENCRYPTION_KEY=thisismysecret
APP_URL = http://localhost:3000 # this ist the url of the client server.


#AWS Chat history bucket name
CHAT_HISTORY_BUCKET = 'phantomx'

# Chat history storage flags
# SAVE_HISTORY_TO_S3: set to 'false' to disable saving/loading chat history from AWS S3 (default: true)
# SAVE_HISTORY_TO_LOCAL: set to 'true' to also save chat history to local chat-history/ folder (default: false)
# If both are true: history is saved to both; S3 is always used as the source of truth for loading
# If only SAVE_HISTORY_TO_LOCAL is true (S3 disabled): history is saved to and loaded from local folder only
SAVE_HISTORY_TO_S3=true
SAVE_HISTORY_TO_LOCAL=false
TAVILY_API_KEY = your tavily api key for web search tool for the agent.
AZURE_OPENAI_API_KEY= your azure openai api key for using azure openAI models

# Paywall kill-switch: set to 'true' to disable all plan/subscription enforcement
# When true: new users skip billing setup after onboarding, existing users are never redirected to billing,
# and all plan constraint checks (tasks, workspaces, team members, credits) are bypassed.
DISABLE_PAYWALL=false

# Auth mode flags
# ENABLE_GITHUB_LOGIN: show GitHub OAuth button on login/register. Set to 'false' to hide it.
ENABLE_GITHUB_LOGIN=true
# ENABLE_NORMAL_LOGIN: enable name-only auth (no email, no password, no OTP).
# User enters first + last name -> account created or found -> logged in immediately.
ENABLE_NORMAL_LOGIN=false
# DISABLE_TOKEN_EXPIRY: when 'true', JWT access tokens have no exp claim and refresh tokens
# last 100 years. Set to 'true' together with ENABLE_NORMAL_LOGIN for zero-friction access.
DISABLE_TOKEN_EXPIRY=false

SAVE_HISTORY_TO_LOCAL=true
SAVE_HISTORY_TO_S3=false
